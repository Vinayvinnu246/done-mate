{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jdgfdgdqaqigybvoxvzg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "donetoday-mcp",
      "version": "0.1.0",
      "title": "DoneToday"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List service categories",
        "description": "List the DoneToday service categories customers can post jobs in (cleaning, plumbing, gardening, etc.).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_jobs",
        "title": "List my jobs",
        "description": "List jobs the signed-in customer has posted on DoneToday, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter.",
              "type": "string",
              "enum": [
                "open",
                "quoted",
                "booked",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "post_job",
        "title": "Post a job",
        "description": "Post a new service job on DoneToday as the signed-in customer. Providers will send quotes.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 5,
              "maxLength": 120,
              "description": "Short summary of the job."
            },
            "description": {
              "type": "string",
              "minLength": 20,
              "maxLength": 2000,
              "description": "What needs to be done."
            },
            "category_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Category UUID from list_categories."
            },
            "urgency": {
              "type": "string",
              "enum": [
                "standard",
                "today",
                "emergency"
              ],
              "description": "Urgency level."
            },
            "address_line1": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "city": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "postcode": {
              "type": "string",
              "minLength": 3,
              "maxLength": 20
            },
            "budget_min": {
              "type": "number",
              "minimum": 0
            },
            "budget_max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "title",
            "description",
            "category_id",
            "urgency",
            "address_line1",
            "city",
            "postcode"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_available_jobs",
        "title": "List available jobs",
        "description": "List open jobs on DoneToday that the signed-in provider can quote on.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "submit_quote",
        "title": "Submit a quote",
        "description": "Submit a quote on an open job as the signed-in provider.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "price": {
              "type": "number",
              "minimum": 0,
              "description": "Total price in GBP."
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 15,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "job_id",
            "price"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
